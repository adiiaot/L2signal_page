generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProofTweet {
  id           String   @id
  account      String   // demo | prop
  date         String
  signalNo     Int?
  result       String   // win | loss | partial_win | expired | win_milestone
  pnl          Float?
  rr           Float?
  capitalAfter Float?
  tweetUrl     String
  imagePath    String?  // /prop/...jpg or null for demo
  caption      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
